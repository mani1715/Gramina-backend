# GramaMitra Backend - Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection (Required)
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=gramamitra

# JWT Configuration (Required)
# Generate a strong secret key
JWT_SECRET=your_super_secure_jwt_secret_key_here

# Admin Account (Optional - auto-created on startup)
ADMIN_EMAIL=admin@gramamitra.com
ADMIN_PASSWORD=your_admin_password

# Email Configuration (Required for OTP)
# For Gmail: Enable "Less secure app access" or use App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Gemini AI API Key (Optional - for voice processing)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL (for CORS) - CRITICAL for Railway deployment
# Set this to your actual Railway frontend URL
# Example: https://gramina-frontend-production.up.railway.app
FRONTEND_URL=https://gramina-frontend-production.up.railway.app
